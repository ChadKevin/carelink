# ═══════════════════════════════════════════════════════════════════
# CareLink Frontend — example environment (committed to git, NO secrets)
#
# Copy this to `.env` locally, or add these variables in your hosting
# dashboard (e.g. Vercel → Project → Settings → Environment Variables).
#
# These are read at BUILD time by Vite (import.meta.env.VITE_*).
# ═══════════════════════════════════════════════════════════════════

# Where the CareLink backend lives. Local dev uses the Vite proxy target,
# but for a DEPLOYED frontend this MUST be the public backend URL —
# NOT http://localhost:8080 (a visitor's browser can't reach your
# machine's localhost).
VITE_API_BASE_URL=https://your-backend.onrender.com/api

# Google Maps / Places API key (the same key works for both).
# Vercel / local build will inline this into the JS bundle, so it's
# visible in the browser (normal for Maps JS keys).
VITE_GOOGLE_MAPS_API_KEY=AIzaSyYourKeyHere

# ── Deployment cheatsheet ──────────────────────────────────────────
# Frontend  → Vercel:            VITE_API_BASE_URL, VITE_GOOGLE_MAPS_API_KEY
# Backend   → Render/Railway:    CARELINK_GOOGLE_MAPS_API_KEY  (+ Postgres URL)
#   (Spring Boot/Java can't run on Vercel's serverless platform)
# ────────────────────────────────────────────────────────────────────